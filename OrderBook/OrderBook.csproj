<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrderBook</AssemblyName>
    <RootNamespace>OrderBook</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <!-- Release builds get tiered PGO and server-GC-free single-thread throughput. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bundle the input so the project runs out-of-the-box after a release build. -->
    <None Update="ticks.raw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
